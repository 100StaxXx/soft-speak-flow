# Supabase Configuration
# Frontend-safe values only
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Google OAuth Configuration
# Get these from Google Cloud Console -> APIs & Services -> Credentials
VITE_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Google Maps Places Autocomplete (frontend/public browser key)
# Enable Maps JavaScript API + Places API/Places API (Legacy) in Google Cloud and restrict this key
# to your app domains / bundle targets before shipping.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
# Optional: set true only in diagnostic builds. Logs loader status without printing the key.
VITE_GOOGLE_MAPS_DEBUG=false

# Native redirect base for Capacitor builds
# Must be the exact origin where the deployed React app is served (no trailing slash,
# no subdomain that 30x-redirects to a different host). Calendar OAuth native callbacks
# use Supabase Edge Function callbacks; this origin is still used for other native
# app redirects and hosted fallback flows.
# Example: https://app.cosmiq.quest
VITE_NATIVE_REDIRECT_BASE=https://your-app-domain.com

# Cloudflare Turnstile (publishable site key only)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Optional frontend build metadata
# VITE_APP_VERSION=1.2.3
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# RevenueCat public SDK key for native iOS builds.
# Use the platform-specific Apple/iOS key for App Store sandbox, TestFlight, and production.
# Use a Test Store key only in compatible development builds.
# VITE_REVENUECAT_IOS_API_KEY=appl_your_public_apple_key
# Set to true only when debugging RevenueCat SDK startup/configuration.
# VITE_REVENUECAT_DEBUG=false

# Set to true only when debugging native orientation lock/unlock calls.
# VITE_ORIENTATION_DEBUG=false

# Server-only/local automation values
# Keep these in .env.local or your secret manager, never in tracked files.
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
# SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# INTERNAL_FUNCTION_SECRET=replace-with-a-long-random-secret
# INFLUENCER_DASHBOARD_SECRET=replace-with-a-long-random-secret

# Apple OAuth Configuration
# These should be set in Supabase secrets via the dashboard, not in .env
# APPLE_SERVICE_ID=com.your-company.your-app.web
# APPLE_ISSUER_ID=YOUR_APP_STORE_CONNECT_ISSUER_ID
# APPLE_KEY_ID=YOUR_KEY_ID
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...keep in Supabase secrets...\n-----END PRIVATE KEY-----"
# APPLE_IOS_BUNDLE_ID=com.your-company.your-app
# APPLE_SUBSCRIPTION_OFFER_CODE_ID=YOUR_EXISTING_YEARLY_REFERRAL_OFFER_CODE_RESOURCE_ID
# APPLE_OFFER_CODE_IDENTIFIER=referrals
# APPLE_OFFER_CODE_YEARLY_PRICE_CENTS=6999
# APPLE_GENESIS_OFFER_CODE_IDENTIFIER=GENESIS
# APPLE_GENESIS_OFFER_CODE_YEARLY_PRICE_CENTS=4999
# APPLE_OFFER_CODE_MAX_REDEMPTIONS_PER_CUSTOM_CODE=25000
# Leave unset for no expiration.
# APPLE_OFFER_CODE_EXPIRATION_DATE=YYYY-MM-DD

# AI Provider (set in Supabase project secrets, not frontend env)
# OPENAI_API_KEY=sk-...
# OPENAI_FORMATION_MODEL=gpt-5.6-luna
# FAL_KEY=...
# Use sandbox only for local/dev Supabase function testing.
# PHOTOROOM_MODE=live
# PHOTOROOM_API_KEY_SANDBOX=sandbox_...
# PHOTOROOM_API_KEY_LIVE=...
# COMPANION_ANIMATION_ENABLED=false
# FAL_KLING_MODEL=fal-ai/kling-video/v3/standard/image-to-video
# Companion AI defaults use GPT-5.4 mini for high-volume UX. Override to
# GPT-5.5 only for premium experiments or staged rollback.
# OPENAI_COMPANION_CHAT_MODEL=gpt-5.4-mini
# OPENAI_COMPANION_AGENT_MODEL=gpt-5.4-mini
# OPENAI_COMPANION_PLANNER_MODEL=gpt-5.4-mini
# OPENAI_COMPANION_MEMORY_MODEL=gpt-4.1-mini
# OPENAI_COMPANION_JUDGE_MODEL=gpt-4.1-mini
# OPENAI_COMPAT_IMAGE_MODEL=gpt-image-1-mini
# OPENAI_COMPANION_IMAGE_MODEL=gpt-image-1-mini
# OPENAI_COMPANION_IMAGE_FALLBACK_MODELS=gpt-image-1
# COSMIQ_TITLE_CARD_IMAGE_MODEL=gpt-image-1-mini
# COSMIQ_TITLE_CARD_IMAGE_FALLBACK_MODELS=gpt-image-1
# COSMIQ_TITLE_CARD_IMAGE_QUALITY=medium
# COMPANION_IMAGE_STAGE0_MAX_RETRIES=0
# COMPANION_IMAGE_NON_STAGE0_MAX_RETRIES=0
# COMPANION_EVOLUTION_RENDER_ATTEMPTS=1
# COMPANION_IMAGE_HIDDEN_QUALITY=medium
# COMPANION_IMAGE_FINAL_QUALITY=medium
# COMPANION_DECAY_IMAGE_AUTOGENERATION=false
# ELEVENLABS_API_KEY=...
# PLANNER_OPTIMIZER_ENABLED=true
# PLANNER_OPTIMIZER_URL=http://127.0.0.1:8010/optimize
# PLANNER_OPTIMIZER_SECRET=replace-with-a-shared-secret
#
# Cost guardrails (set these in Supabase project secrets, not frontend env)
# COST_KILL_SWITCH_ALL=false
# COST_KILL_SWITCH_TEXT=false
# COST_KILL_SWITCH_IMAGE=false
# COST_KILL_SWITCH_TTS=false
# COST_KILL_SWITCH_MUSIC=false
# COST_KILL_SWITCH_TRANSCRIPTION=false
# COST_KILL_SWITCH_VIDEO=false
# COST_KILL_SWITCH_ENDPOINTS=generate-companion-image,generate-rhythm-track
# COST_ALERT_WEBHOOK_URL=https://your-alert-endpoint.example/webhook
# COST_ALERT_WEBHOOK_BEARER_TOKEN=replace-me
# TURNSTILE_SECRET_KEY=your-turnstile-secret
# INFLUENCER_DASHBOARD_SECRET=use-a-random-32+-character-secret
# Product surface. Defaults to Graceward when omitted; use "cosmiq" for the
# agenda-first Cosmiq build.
VITE_PRODUCT_MODE=christian
