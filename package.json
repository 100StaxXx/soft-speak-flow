    "companions:hatchlings:pipeline": "npm run companions:hatchlings:import",
    "companions:initiate:import": "node --import tsx scripts/import-companion-initiate-assets.ts",
    "companions:initiate:sync": "node --import tsx scripts/sync-companion-initiate-assets.ts",
    "companions:initiate:pipeline": "npm run companions:initiate:import && npm run companions:initiate:sync",
    "planner:optimizer:dev": ". .venv/bin/activate && python3 -m uvicorn services.planner_optimizer_service.app:app --host 127.0.0.1 --port 8010",
    "planner:optimizer:test": ". .venv/bin/activate && python3 -m unittest services/planner_optimizer_service/test_optimizer.py",
    "planner:rollout:smoke": "deno test --allow-net=127.0.0.1 supabase/functions/companion-planner-chat/rollout.smoke.ts",
    "planner:phase-a:ui": "npx vitest run src/services/companionChatThreads.test.ts src/hooks/useCompanionAssistant.test.tsx src/hooks/useCompanionPlanner.test.tsx src/hooks/useLegacyCompanionAssistantAdapter.test.tsx src/components/companion/CompanionStructuredResponseCards.test.tsx src/components/journeys/JourneysCompanionPlannerModal.test.tsx",
    "planner:phase-a:backend": "deno test supabase/functions/companion-planner-chat/planner.test.ts supabase/functions/companion-planner-chat/orchestrator.test.ts supabase/functions/companion-planner-chat/latencyBudget.test.ts supabase/functions/companion-agent/plannerBridge.test.ts supabase/functions/companion-agent/types.test.ts supabase/functions/companion-agent/agent.test.ts",
    "planner:phase-a:typecheck": "node scripts/check-planner-phase-a-slice.mjs",
    "planner:phase-a:check": "npm run planner:phase-a:ui && npm run planner:phase-a:backend && npm run planner:phase-a:typecheck",
    "previews:manifest": "node --import tsx scripts/generate-badge-reward-manifests.ts",
    "previews:render": "node --import tsx scripts/render-badge-reward-previews.ts",
    "previews:sync": "node --import tsx scripts/sync-badge-reward-previews.ts",
    "previews:validate": "node --import tsx scripts/validate-badge-reward-previews.ts",
    "previews:build": "npm run previews:manifest && npm run previews:render",
    "previews:pipeline": "npm run previews:build && npm run previews:sync && npm run previews:validate",
    "adversaries:prewarm": "node scripts/prewarm-adversary-images.mjs",
    "test:campaign-index": "npm run test:migrations:habit-index:static",
    "test:migrations:static": "deno test --allow-read=supabase/migrations supabase/tests/migrations/*.test.ts",
    "test:migrations:habit-index:static": "deno test --allow-read=supabase/migrations supabase/tests/migrations/daily-task-habit-conflict-index.test.ts",
    "test:migrations:habit-index:db": "supabase test db supabase/tests/migrations/01_daily_task_habit_conflict_index.sql",
    "test:migrations:habit-index": "npm run test:migrations:static && npm run test:migrations:habit-index:db",
    "test:security:db": "supabase test db supabase/tests/security/01_rls_and_storage.sql supabase/tests/security/02_entitlements_and_rpc.sql supabase/tests/security/04_companion_claim_validation.sql",
    "test:security:functions": "./scripts/run-security-function-tests.sh",
    "test:security": "npm run test:security:db && npm run test:security:functions"
  },
