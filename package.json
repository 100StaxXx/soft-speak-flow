{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "secrets:scan:staged": "node scripts/scan-secrets.mjs --staged",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "preview": "vite preview",
    "postinstall": "patch-package",
    "cards:snapshot": "tsx scripts/cardSnapshot.ts",
    "manifest:generate": "./scripts/generate-function-manifest.sh",
    "manifest:check": "./scripts/check-function-manifest.sh",
    "ios:sync": "npm run build && npx cap sync ios && node scripts/fix-widget-config.cjs && npm run ios:verify-assets",
    "ios:verify-assets": "node scripts/verify-ios-web-assets.mjs",
    "ios:verify-assets:generated": "node scripts/verify-ios-web-assets.mjs --scan-generated-builds",
    "ios:verify-widget-signing": "node scripts/verify-widget-signing.mjs",
    "ios:smoke:device": "node scripts/ios-device-smoke.mjs",
    "ios:preflight": "npm run ios:sync && npm run ios:verify-widget-signing",
    "ios:testflight": "npm run ios:preflight && node scripts/open-xcode.js",
    "pep-talks:backfill-transcripts": "node scripts/backfill-missing-pep-talk-transcripts.mjs",
    "companions:stage2:manifest": "node --import tsx scripts/generate-companion-stage2-manifest.ts",
    "companions:stage2:generate-sheets": "node --import tsx scripts/generate-companion-stage2-sheets.ts",
    "companions:stage2:extract-sheet": "node --import tsx scripts/extract-companion-element-sheet.ts",
    "companions:stage2:sheets": "node --import tsx scripts/render-companion-stage2-contact-sheets.ts",
    "companions:expressive:manifest": "node --import tsx scripts/generate-companion-expressive-manifest.ts",
    "companions:expressive:sheets": "node --import tsx scripts/render-companion-expressive-contact-sheets.ts",
    "companions:portraits:refresh": "node scripts/refresh-companion-portrait-assets.mjs",
